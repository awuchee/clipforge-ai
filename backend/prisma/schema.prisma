generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
  AGENCY
}

enum ProcessingStatus {
  PENDING
  UPLOADED
  QUEUED
  PROCESSING
  DONE
  FAILED
  REJECTED
}

enum SourceType {
  YOUTUBE
  UPLOAD_VIDEO
  UPLOAD_AUDIO
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  avatarUrl String?

  plan                Plan   @default(FREE)
  videosUsedThisMonth Int    @default(0)
  usageResetAt        DateTime @default(now())
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique
  subscriptionStatus   String?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]

  @@map("users")
}

model Project {
  id               String           @id @default(cuid())
  title            String
  sourceType       SourceType
  sourceUrl        String?
  storageKey       String?
  videoUrl         String?
  originalFilename String?
  status           ProcessingStatus @default(PENDING)
  durationSec      Int?
  transcript       Json?
  errorMessage     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  clips Clip[]

  @@map("projects")
  @@index([userId])
}

/// Tracks Stripe webhook event IDs that have already been applied, so retried
/// or duplicate deliveries (Stripe retries on any non-2xx response) are no-ops.
model ProcessedStripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())

  @@map("processed_stripe_events")
}

model Clip {
  id           String           @id @default(cuid())
  startSec     Float
  endSec       Float
  storageKey      String?
  thumbnailKey    String?
  srtKey          String?
  hookTitles      String[]
  hookVariations  Json?
  selectedHookTitle String?
  description     String?
  hashtags        String[]
  viralScore      Int?
  qualityScore    Float?
  selectionReason String?
  platform        String?
  captionStyle    Json?
  captionTheme    String?
  captionWords    Json?
  fontSize        Int?
  captionPosition String?  @default("bottom")
  emojiEnabled    Boolean  @default(true)
  status          ProcessingStatus @default(QUEUED)
  errorMessage    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("clips")
  @@index([projectId])
}
