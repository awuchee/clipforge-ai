# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vixclip?schema=public"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# App
PORT=4000
FRONTEND_URL="http://localhost:3000"
# Base URL the API is reachable at - used to build local-storage file URLs (STORAGE_DRIVER=local)
API_BASE_URL="http://localhost:4000"

# Storage driver: "s3" | "local". If unset, defaults to "s3" when S3 credentials below are
# fully set, otherwise falls back to "local" disk storage served from /files/<key>.
STORAGE_DRIVER=""
# Directory used for local disk storage (STORAGE_DRIVER=local). Defaults to backend/storage-data.
STORAGE_LOCAL_DIR=""

# Storage (Cloudflare R2 / S3)
# S3_ENDPOINT: R2 account endpoint, e.g. https://<account_id>.r2.cloudflarestorage.com
#              (leave empty to use AWS S3 default endpoints)
S3_ENDPOINT=""
S3_BUCKET="vixclip-uploads"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="auto"
# Public base URL used to construct videoUrl, e.g. a R2 public bucket or custom domain
S3_PUBLIC_URL=""

# Max upload size in MB for project source files
MAX_UPLOAD_SIZE_MB=2048

# AI providers - used by the processing pipeline (transcription + viral metadata)
OPENAI_API_KEY=""

# Local offline TTS fallback for ad voiceover (used automatically when OPENAI_API_KEY is unset).
# Defaults to backend/bin/piper/piper(.exe) and backend/bin/piper/voices — run
# backend/scripts/setup-piper.sh (or .ps1) to download these. Override only if installed elsewhere.
PIPER_EXECUTABLE_PATH=""
PIPER_VOICES_DIR=""

# Redis - used by the BullMQ job queue (producer + worker)
# REDIS_URL takes precedence if set, e.g. redis://[:password@]host:port
REDIS_URL=""
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=""

# Worker process: HTTP port used for GET /worker-health
WORKER_PORT=4100

# Local temp directory used by the worker for downloads/renders (defaults to OS tmpdir)
WORKER_TMP_DIR=""

# Max number of clips to generate per video
MAX_CLIPS_PER_VIDEO=10
MIN_CLIPS_PER_VIDEO=3

# Clip quality filter - clips below these thresholds are rejected and not uploaded
MIN_VIRAL_SCORE=35
MIN_QUALITY_SCORE=0.15
MIN_TRANSCRIPT_WORDS=8

# Caption theme used for burned-in subtitles: bold | minimal | neon | classic
# Leave empty to rotate through all themes across a project's clips.
CAPTION_THEME=""

# Stripe billing
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price ID for the Pro plan subscription (Stripe Dashboard -> Product catalog)
STRIPE_PRICE_PRO_ID=""
